node_modules/
jspm_packages/

# Production build artifacts
dist/
build/
output/

# Debug and log files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# TypeScript cache
*.tsbuildinfo

# Next.js / Remix / Gatsby specific (if applicable)
.next/
.cache/

# ==========================================
# 4. Security & Environment Variables
# ==========================================
